# ====================================================================
# Apex League Hub - Production Environment Variables
# ====================================================================

# --------------------------------------------------------------------
# 1. Backend API Service Configuration (Render, Railway, Fly.io)
# --------------------------------------------------------------------
# Server port (automatically provided by hosting platforms like Render)
PORT=8000

# Allowed CORS origins for frontend domain security (comma-separated, or * for all)
# Example: https://apex-league.vercel.app,https://apex-league.netlify.app
CORS_ORIGINS=*

# Python version for build environment
PYTHON_VERSION=3.11.0


# --------------------------------------------------------------------
# 2. Frontend Configuration (Used in config.js or Vercel/Netlify proxy)
# --------------------------------------------------------------------
# Your deployed production backend URL
# Example: https://apex-sports-league-api.onrender.com/api
PRODUCTION_API_BASE=https://your-backend-api.onrender.com/api

# Your deployed backend Swagger UI documentation URL
# Example: https://apex-sports-league-api.onrender.com/docs
PRODUCTION_DOCS_URL=https://your-backend-api.onrender.com/docs
