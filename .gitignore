# ====================================================================
# Apex League Hub - Git Ignore Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. Environment Variables & Secrets
# --------------------------------------------------------------------
.env
.env.local
.env.development
.env.test
.env.production
.env*.local
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json

# Keep environment example template in repository
!.env.example

# --------------------------------------------------------------------
# 2. SQLite Databases & Local State
# --------------------------------------------------------------------
# Exclude SQLite databases to avoid leaking user records, credentials,
# or bloating repository history with binary diffs.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# --------------------------------------------------------------------
# 3. Python Bytecode, Caches & Artifacts
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --------------------------------------------------------------------
# 4. Python Virtual Environments
# --------------------------------------------------------------------
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# --------------------------------------------------------------------
# 5. Node & Frontend Dependencies (if build tools are used)
# --------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.parcel-cache/
.cache/

# --------------------------------------------------------------------
# 6. Operating System & Editor Metadata
# --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --------------------------------------------------------------------
# 7. Logs & Temporary Files
# --------------------------------------------------------------------
*.log
*.tmp
*.temp
